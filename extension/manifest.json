{
  "manifest_version": 3,
  "name": "Review AI",
  "description": "Ask Claude about the GitHub pull request you're reviewing, and post the comments it drafts.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
